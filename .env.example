# Copy this file to .env. Never commit the populated .env file.

# -----------------------------------------------------------------------------
# Application and HTTP server
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
# polling | webhook
TELEGRAM_UPDATE_MODE=polling
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_BOT_USERNAME=replace_me_bot
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Required in webhook mode. Generate the secret with: openssl rand -hex 32
TELEGRAM_WEBHOOK_PUBLIC_URL=https://bot.example.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_value
# Limit concurrent synchronous webhook updates to bound DB/media pressure.
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=4

TELEGRAM_POLL_TIMEOUT=30s
TELEGRAM_REQUEST_TIMEOUT=15s

# Comma-separated positive Telegram user IDs authorized for privileged operator
# commands. Privileged actions must be logged to owner_audit_events.
OWNER_TELEGRAM_IDS=123456789

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=secretmediabot
POSTGRES_USER=secretmediabot
POSTGRES_PASSWORD=replace_with_a_long_random_value
DATABASE_URL=postgres://secretmediabot:replace_with_a_long_random_value@postgres:5432/secretmediabot?sslmode=disable

DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=10s

# -----------------------------------------------------------------------------
# Whisper behavior and anti-abuse
# -----------------------------------------------------------------------------
DRAFT_TTL=10m
DEFAULT_WHISPER_TTL=24h
MAX_WHISPER_TTL=168h
DEFAULT_ONE_TIME=true
PROTECT_CONTENT=true
PUBLISH_LEASE_TIMEOUT=2m
PUBLISH_INTERVAL=2s
EPHEMERAL_DELETE_AFTER=30s
EPHEMERAL_DELETE_INTERVAL=2s

MAX_ACTIVE_DRAFTS_PER_USER=1
MAX_WHISPERS_PER_USER_PER_HOUR=30

# Comma-separated Telegram group/supergroup IDs; empty allows all groups.
ALLOWED_CHAT_IDS=

# -----------------------------------------------------------------------------
# Encrypted media storage
# -----------------------------------------------------------------------------
MEDIA_STORAGE=postgres
MAX_MEDIA_BYTES=20971520
MEDIA_RETENTION=720h
MEDIA_DOWNLOAD_TIMEOUT=2m
MEDIA_ENCRYPTION_KEY_ID=v1

# Required: base64-encoded 32-byte AES key. Generate with:
#   openssl rand -base64 32
MEDIA_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# -----------------------------------------------------------------------------
# Cleanup
# -----------------------------------------------------------------------------
CLEANUP_INTERVAL=5m
CLEANUP_BATCH_SIZE=500
PROCESSED_UPDATE_RETENTION=168h
